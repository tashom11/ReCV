{
  "extends": "./tsconfig.base.json",
  "include": [
    "src/renderer/src/**/*",
    "src/preload/*.d.ts",
    "src/core/schemas/*.ts",
    "src/core/api.ts",
    "src/core/adaptation/composition.ts",
    "src/core/adaptation/competences.ts",
    "src/core/export/modeles.ts",
    "src/core/adaptation/texte.ts",
    "src/core/canaux.ts",
    "src/core/serviceUrl.ts",
    "src/core/erreurs.ts",
    "src/core/etapes.ts"
  ],
  "exclude": ["src/**/*.test.ts"],
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "paths": {
      "@core/*": ["./src/core/*"],
      "@renderer/*": ["./src/renderer/src/*"]
    },
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.web.tsbuildinfo"
  }
}
