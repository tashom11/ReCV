{
  "extends": "./tsconfig.base.json",
  "include": ["src/renderer/src/**/*", "src/preload/*.d.ts", "src/core/**/*"],
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "paths": {
      "@core/*": ["./src/core/*"],
      "@renderer/*": ["./src/renderer/src/*"]
    },
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.web.tsbuildinfo"
  }
}
