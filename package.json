{
  "name": "recv",
  "productName": "ReCV",
  "version": "0.4.0",
  "description": "Adapte ton CV à chaque offre, en local.",
  "private": true,
  "license": "MIT",
  "author": "Re:CV contributors",
  "main": "./out/main/index.js",
  "scripts": {
    "postinstall": "node node_modules/electron/install.js",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "build:win": "npm run build && electron-builder --win --publish never",
    "preview": "electron-vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "format": "biome format --write .",
    "try": "tsx scripts/try-pipeline.ts",
    "check:personal-data": "node scripts/check-personal-data.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.67",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@mozilla/readability": "^0.6.0",
    "ai": "^7.0.137",
    "better-sqlite3": "^13.0.3",
    "docx": "^9.10.0",
    "drizzle-orm": "^0.45.4",
    "electron-updater": "^6.8.9",
    "linkedom": "^0.18.13",
    "mammoth": "^1.13.0",
    "node-llama-cpp": "^3.22.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "unpdf": "^1.8.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "axe-core": "^4.14.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "happy-dom": "^21.0.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^7.3.7",
    "vitest": "^5.0.4"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  }
}
